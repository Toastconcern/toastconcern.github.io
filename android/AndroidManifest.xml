<?xml version="1.0" encoding="utf-8"?>
<!-- MetaDB for the headset: the site in a full-screen web view, with the relay
     built in. Sideload it; it is not on the store. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.toastconcern.metadb"
    android:versionCode="4"
    android:versionName="1.3">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Installing a build from the site: hand it to Android's installer, remove
         the app first when going back to an older build, and see which version
         of an app is already installed. Android asks before each install and
         uninstall; these only let MetaDB ask. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Only to put a game's expansion file in Android/obb, where the game looks
         for it. Asked for the first time a build with one is installed. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Android 10 has no all-files access; there, the older storage permission
         (with legacy storage, below) is what lets MetaDB write in Android/obb. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <application
        android:label="MetaDB"
        android:icon="@drawable/icon"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true">

        <!-- The site this app shows. build.sh can point a test build elsewhere. -->
        <meta-data android:name="metadb.site" android:value="https://metadb.toastconcern.dev/" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|smallestScreenSize">
            <!-- Opens as a landscape window a little larger than the Quest Browser's; it can
                 still be resized from its edges. -->
            <layout
                android:defaultWidth="1280dp"
                android:defaultHeight="800dp"
                android:gravity="center" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
